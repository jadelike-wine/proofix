{
  "name": "proofix",
  "version": "0.1.0",
  "private": true,
  "description": "Your AI fixed the bug. Now prove it. — Local, verifiable bug-fix verification for coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jadelike-wine/proofix.git"
  },
  "homepage": "https://github.com/jadelike-wine/proofix#readme",
  "bugs": "https://github.com/jadelike-wine/proofix/issues",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "test": "pnpm -r --filter './packages/*' run test",
    "lint": "pnpm -r --filter './packages/*' run lint",
    "demo": "pnpm --filter @proofix/cli run build && node packages/cli/dist/bin.js demo"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
}
