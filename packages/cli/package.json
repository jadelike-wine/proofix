{
  "name": "@proofix/cli",
  "version": "0.1.0",
  "description": "ProofFix CLI — prove that a bug fix actually works.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "proofix": "dist/bin.js"
  },
  "main": "dist/index.js",
