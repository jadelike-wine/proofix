{
  "name": "@proofix/cli",
  "version": "0.1.0",
  "description": "ProofFix CLI — prove that a bug fix actually works.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "proofix": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && esbuild src/bin.ts --bundle --format=esm --platform=node --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --outfile=dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@proofix/core": "workspace:*",
    "commander": "^12.1.0",
    "yaml": "^2.6.1",
    "esbuild": "^0.28.2"
  }
}
