{
    "name": "@proofix/dsh-plugin",
    "version": "0.1.0",
    "description": "ProofFix DeepSeek Harness plugin — prove a claimed bug fix inside your agent session.",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "cordis.patch.yml"
    ],
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json --emitDeclarationOnly && esbuild src/index.ts --bundle --format=esm --platform=node --external:@deepseek-ai/* --outfile=dist/index.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --passWithNoTests",
        "lint": "tsc -p tsconfig.json --noEmit"
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.0.2",
        "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1",
        "@deepseek-ai/schemastery": "^3.18.0"
    },
    "devDependencies": {
        "@deepseek-ai/cordis": "^4.0.2",
        "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
        "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
        "@deepseek-ai/schemastery": "^3.18.6",
        "@proofix/core": "workspace:*",
        "esbuild": "^0.28.2"
    }
}
